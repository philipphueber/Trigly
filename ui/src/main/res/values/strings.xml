<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Trigly</string>
    <!--
      The app's own name, not the screen's contents. This is the first screen you
      see and the one the launcher icon opens, so it is the place a person checks
      which app they are in; "Rules" described what is below it, which the blocks
      already say for themselves.
    -->
    <string name="rules_title">Trigly</string>
    <!--
      Deliberately doesn't quote the new-rule button's rendered text (it used to
      say Tap "NEW RULE" to make one, a literal copy of what rules_new looks like
      once BlockButton uppercases it). That copy had no mechanism to follow
      rules_new if its wording ever changed, so it would have gone stale
      silently. Point at the button by position instead of by label.
    -->
    <string name="rules_empty">No rules yet. Add one below to get started.</string>
    <string name="rules_new">New rule</string>
    <string name="rules_import">Import</string>
    <string name="rules_export_all">Export all</string>
    <!--
      The editor's variable picker calls this group "Saved, and shared with
      every rule". This is that same phrase, shortened to a header entry, so
      the two places that talk about app-scope variables agree on what to call
      them.
    -->
    <string name="rules_saved_values">Saved values</string>
    <!-- The overflow beside "New rule". Three dots, not a word, because a
         label would claim to describe one particular entry, and this menu
         is a few different ones. -->
    <string name="rules_more">\u2026</string>
    <string name="saved_values_menu_empty">Nothing saved yet</string>
    <string name="rules_settings">Settings</string>
    <!-- Under the row that opens the saved values screen. -->
    <string name="saved_values_entry_empty">Nothing saved yet. A rule can store a value here for any rule to read.</string>
    <plurals name="saved_values_entry_count">
        <item quantity="one">%1$d value, shared with every rule</item>
        <item quantity="other">%1$d values, shared with every rule</item>
    </plurals>
    <string name="rules_share">Share</string>
    <string name="rules_duplicate">Duplicate</string>
    <!-- Opens a tree of the rule's last trigger evaluation. See TriggerTraceScreen. -->
    <string name="rules_last_check">Last check</string>
    <!--
      Names the action, because a rule with three actions otherwise leaves the
      reader to guess which one this is about. The reason follows on its own
      line, in the action's own words.
    -->
    <string name="rules_last_run_failed">Last run failed: %1$s</string>
    <!--
      The heading for a rule that fired and then ran nothing, because part of
      its trigger never said whether it held, even after Trigly asked again.
      Not "failed": nothing ran, so there is no action to blame. The body names
      the components that never answered and says what that leaves unknown.
    -->
    <string name="rules_last_run_undecided">Last run stopped</string>
    <string name="rules_could_not_decide">Trigly asked %1$s more than once and got no answer, so the rule did not run.</string>
    <!--
      The heading for a rule that was never built, so nothing is watching for
      it. Not "failed" and not "stopped": both of those describe a run, and
      there was no run. The body quotes what the failure said, because the
      cause is nearly always one named component or one bad setting, and the
      person can only act on it if they are told which.
    -->
    <string name="rules_never_started">Rule not started</string>
    <string name="rules_could_not_start">Trigly could not build this rule, so nothing is watching for it. %1$s</string>
    <string name="requirement_grant">Grant</string>
    <string name="rules_search_label">Search</string>
    <!--
      Sentence case, like rules_empty above: this is prose explaining a state,
      not chrome. Named with the query in it rather than a bare "No matches" so
      it cannot be read as "you have no rules" — the whole reason this string
      exists instead of reusing rules_empty for a filtered-to-nothing list.
    -->
    <string name="rules_no_matches">No rules match “%1$s”.</string>
    <!--
      The catch-all folder heading. Uppercased by FolderHeader like every other
      folder name, so it is not given capitals of its own here.
    -->
    <string name="rules_folder_other">Other</string>

    <!--
      The engine's ongoing notification. Sentence case, not the uppercase the
      screens use for chrome: this is read in the shade next to other apps'
      notifications, where Trigly's typography does not apply.
    -->
    <string name="engine_channel_name">Running in the background</string>
    <string name="engine_channel_description">This channel shows that Trigly watches for triggers. Android requires it while a rule runs.</string>
    <string name="engine_starting">Starting…</string>
    <string name="engine_none_started">No rule started. Open Trigly to find out why.</string>
    <plurals name="engine_watching">
        <item quantity="one">Trigly watches %d rule</item>
        <item quantity="other">Trigly watches %d rules</item>
    </plurals>

    <!--
      The button next to a requirement that is granted but not live: see
      RequirementChecker.grantedButNotLive. Named apart from requirement_grant
      because the setting is already on, so "Grant" would ask the user to
      redo something they already did.
    -->
    <string name="requirement_check_settings">Check settings</string>

    <!--
      The app-wide battery optimisation notice on the rules screen. See
      BatteryOptimizationNotice in RulesScreen.kt for why this is one notice
      above the list rather than a row on each rule.

      battery_optimization_body says three things and stops there: what can
      happen, what this setting does about it, and what it does not do about
      a force-stop. It must not read as "tap this and rules always run" -
      that is a promise this setting cannot keep.

      Each sentence names its subject. An earlier draft used "stop" for both
      halves ("this setting is what stops it. It does not stop a force-stop"),
      where the two "it" words pointed at different things one sentence apart.
    -->
    <string name="battery_optimization_title">Android can stop Trigly</string>
    <string name="battery_optimization_body">This can happen when the phone is idle. No rule runs then. This setting prevents it. A force-stop is different. If you stop Trigly in Settings, no rule runs until you open Trigly again.</string>
    <string name="battery_optimization_action">Allow</string>

    <!--
      The settings screen. One switch today: see TriglyBackupAgent and
      SettingsScreen.kt.

      settings_backup_warning_body says four things and stops there, in the
      order a person needs them: what backup can copy, where the copy goes,
      what happens with no Google account, and what still works with the
      switch off. It must not talk a person out of a switch that is on by
      default for a real reason, and it must not hide what turning it on
      actually does.
    -->
    <string name="settings_title">Settings</string>
    <string name="settings_backup_title">Back up to your account</string>
    <string name="settings_backup_warning_title">What backup shares</string>
    <string name="settings_backup_warning_body">Backup can copy your rules and your saved values. A webhook URL often carries a token. Backup copies that token too. The copy goes to the account signed in on this phone. A phone with no Google account and no backup service sends nothing. Moving data straight to your next phone still works with this off.</string>

    <!--
      The colour scheme row and its picker. See ColorSchemeSettings and
      PresetSchemes.kt for what each choice means and how it is resolved.
      The six preset names (Orange, Lime, Green, Azure, Violet, Magenta) are
      not string resources: they are plain Kotlin literals on ColorPreset,
      the same way every other picker in this app names its own catalogue
      entries in code.
    -->
    <string name="settings_colorscheme_title">Colour scheme</string>
    <string name="settings_colorscheme_dialog_title">Choose a colour scheme</string>
    <string name="settings_colorscheme_default">Default</string>
    <string name="settings_colorscheme_system">Follow the system</string>
    <string name="settings_colorscheme_done">Done</string>

    <!--
      Shown once, inside the picker, before a switch actually runs - see
      LauncherIconSwitcher.kt. Reuses the amber caution Surface shape
      settings_backup_warning already uses: this is something to know, not a
      fault.
    -->

    <!--
      The row on the settings screen that opens AttributionScreen. A separate
      resource from attribution_title even though the text is the same today,
      the same choice rules_settings and settings_title already make for
      "Settings": a row's label and a screen's own header answer different
      questions, and a future wording change to one must not silently change
      the other.

      "Used components", not "Open source licenses": the screen credits the
      projects Trigly is built from, and a tap opens each one's own page.
      Naming the licence, which is what the old text did, described only one
      of the two things the screen now does.
    -->
    <string name="settings_attribution_title">Used components</string>

    <!--
      AttributionScreen: the app's own name, version and licence, a link to
      Trigly's own repository, every project it ships code from with a link
      to each one's own page, and a link to the licence text they share. See
      AttributionScreen.kt and Attribution.kt.
    -->
    <string name="attribution_title">Used components</string>
    <string name="attribution_version">Version %1$s</string>
    <string name="attribution_license">This app uses the Apache License 2.0.</string>
    <!--
      One button, pressed by a person, that looks once at GitHub's own
      release list. See UpdateCheck.kt: nothing calls checkForUpdate but this
      button, on a schedule or otherwise.
    -->
    <string name="attribution_check_for_updates">Check for updates</string>
    <string name="attribution_update_checking">Checking…</string>
    <string name="attribution_up_to_date">You have the latest version.</string>
    <string name="attribution_update_available">Version %1$s is available.</string>
    <string name="attribution_update_check_failed">Could not check for updates. %1$s</string>
    <!-- Opens this app's own repository. See MainActivity.AttributionHost. -->
    <string name="attribution_repository_title">Trigly on GitHub</string>
    <string name="attribution_dependencies_heading">Open source components</string>
    <!-- Under a project's name on AttributionScreen: how many Maven artifacts
         of that project this build actually ships. See groupIntoProjects, in
         Attribution.kt. -->
    <plurals name="attribution_artifact_count">
        <item quantity="one">%1$d artifact</item>
        <item quantity="other">%1$d artifacts</item>
    </plurals>
    <!--
      A row that opens the licence text in a browser, not a heading any more:
      see AttributionScreen.kt for why the text is no longer bundled.

      "License text", not "Apache License 2.0": attribution_license just above
      already says the licence by name, and every project row's own trailing
      text says "Apache License 2.0" too, so reusing that phrase here would
      give AttributionScreenTest three nodes with the same exact text to tell
      apart instead of one.
    -->
    <string name="attribution_license_link_title">License text</string>
</resources>
