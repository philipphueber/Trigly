<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Kept in step with `Tone.Paper` in Palette.kt, as values-night is with
      `Tone.Ink`. Two declarations of one colour is not ideal, but the window
      background is resolved by the framework before any Compose code runs, so
      there is no way to read it from the theme.

      Both sides are now written the same way — #RRGGBB here and `hex("#RRGGBB")`
      there — so keeping them in step is a comparison, not a conversion.
    -->
    <color name="window_background">#FFFBF7</color>

    <!--
      The launcher icon's background layer. `Tone.Orange60`, which is also
      `colorScheme.primary` in both themes — the icon and the app's header slab
      are now one colour rather than two neighbouring ones. This value used to be
      the odd one out, brighter than the `Orange40` the chrome carried, on the
      grounds that an icon competes with every other icon on a home screen while
      chrome only competes with its own page. The chrome came up to meet it.

      Deliberately not overridden in values-night. An app icon that changed with
      the system theme would be a different mark on half the phones.
    -->
    <color name="ic_launcher_background">#EC6206</color>

    <!--
      One background colour per other preset, each the same value as that
      preset's own `primary` in PresetSchemes.kt - the icon and the header
      slab are one colour for every preset, the same way ic_launcher_background
      already is for Orange. Only these eight: Default and "Follow the system"
      both keep the orange icon (LauncherAliasOrange), so they need no colour
      of their own here. Also not overridden in values-night, for the same
      reason ic_launcher_background is not.
    -->
    <color name="ic_launcher_background_lime">#8B9E18</color>
    <color name="ic_launcher_background_green">#3AAC64</color>
    <color name="ic_launcher_background_azure">#139CE3</color>
    <color name="ic_launcher_background_violet">#9A7EE3</color>
    <color name="ic_launcher_background_magenta">#D06AA7</color>
    <color name="ic_launcher_background_red">#DF6A60</color>
    <!-- Stone's own tone 70, not tone 60 - its primary is one rung lighter
         than every other preset's, see PresetSchemes.kt's banner. -->
    <color name="ic_launcher_background_stone">#BCAAA0</color>
    <color name="ic_launcher_background_slate">#84969F</color>
</resources>
