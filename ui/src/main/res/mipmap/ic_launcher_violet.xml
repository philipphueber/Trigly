<?xml version="1.0" encoding="utf-8"?>
<!--
  The Violet preset's launcher icon. Same shape as ic_launcher.xml - only the
  background differs - so see that file for why an adaptive icon needs no
  density ladder and no mipmap-anydpi-v26 qualifier here.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background_violet" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
