<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Lets the app-package picker see the installed apps that have a launcher
      icon. Since Android 11 package queries are filtered unless the app declares
      what it is looking for here.

      Deliberately NOT android.permission.QUERY_ALL_PACKAGES: Google treats it as
      a restricted permission needing a declared exception, which is a bad trade
      for a convenience picker. The cost is that an app with no launcher icon is
      not listed, which is why the picker also accepts a typed package name.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
      The engine's host. Declared here rather than in :triggers because the
      service is part of assembling the app, which is this module's other job.

      FOREGROUND_SERVICE_SPECIAL_USE is the type-specific permission that goes
      with android:foregroundServiceType below; from API 34 a foreground service
      must declare a type and hold the matching permission or startForeground
      throws.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".TriglyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Trigly">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Trigly"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Where a tap on a pinned shortcut lands. exported="true" is required
          for the same reason as BootReceiver below: the launcher is a
          different app and can only start this by explicit component name if
          it is exported, regardless of intent-filter matching.

          Theme.NoDisplay rather than a translucent theme: this activity never
          draws, and NoDisplay is the platform's own contract for that - it
          requires finish() to be called before onResume completes and throws
          if it is not, which makes "draws nothing" a checked property instead
          of a hope. excludeFromRecents and noHistory keep a tap from leaving
          behind a task entry or a back-stack entry for an activity nobody
          will ever see.
        -->
        <activity
            android:name=".ShortcutTargetActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
          specialUse, and there is no honest alternative. The catalogue of
          foreground service types describes what the service is *doing* —
          playing media, syncing data, tracking a location — and general-purpose
          automation is none of them. dataSync is the tempting mislabel and is
          also the one Android 15 caps at six hours a day, which would stop the
          engine every evening. specialUse carries no timeout; the price is that
          Google reviews the subtype string below before a Play release, which
          is a fair price for saying what the service actually is.
        -->
        <service
            android:name=".EngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the user's own automation rules. Trigly's triggers are system broadcasts and framework callbacks that are only delivered to a live process, so the rules the user enabled cannot fire unless the app keeps running." />
        </service>

        <!--
          exported="true" is required, not incidental: both actions are sent by
          the system, which is a different uid, and a non-exported receiver only
          hears from its own app. Both are protected broadcasts that only the
          system may send, so nothing else can reach this.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          Hands one rule's JSON to whichever app the person picks from the share
          sheet. Needed because a content URI is the only way to pass a file to
          another app without either of them holding a storage permission: the
          grant is per URI, read only, and lasts as long as the receiving
          activity.

          `exported="false"` with `grantUriPermissions="true"` is the pair that
          makes that true. Not exported means no app may query this provider on
          its own; the grant means the one app we handed a URI to may read that
          one file. An exported provider would be readable by anything installed.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

    </application>

</manifest>
