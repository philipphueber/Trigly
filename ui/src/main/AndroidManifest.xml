<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Lets the app-package picker see the installed apps that have a launcher
      icon. Since Android 11 package queries are filtered unless the app declares
      what it is looking for here.

      Deliberately NOT android.permission.QUERY_ALL_PACKAGES: Google treats it as
      a restricted permission needing a declared exception, which is a bad trade
      for a convenience picker. The cost is that an app with no launcher icon is
      not listed, which is why the picker also accepts a typed package name.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
      The engine's host. Declared here rather than in :triggers because the
      service is part of assembling the app, which is this module's other job.

      FOREGROUND_SERVICE_SPECIAL_USE is the type-specific permission that goes
      with android:foregroundServiceType below; from API 34 a foreground service
      must declare a type and hold the matching permission or startForeground
      throws.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
      The second type the engine can run as. It is what gives a location read
      an answer while no activity is on screen, which is the normal state for
      an automation app. The type is added at runtime and only when a location
      permission is held, because from API 34 `startForeground` throws for a
      declared type the app has no permission for. See
      `EngineService.foregroundTypes`.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!--
      Declared here as well as in :triggers, which is not duplication. The
      module convention is that a module declares what its own code needs, and
      this module's code now needs these: `EngineService.hasLocationGrant`
      reads them to decide whether it may claim the `location` service type.
      The platform ties the two together as one rule, that the type requires
      FOREGROUND_SERVICE_LOCATION and one of these, and a rule split across two
      manifests is one nobody can check. Lint checks it here and fails the
      build if this pair is separated. The merger folds the repeat away.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      Lets MainActivity open the one-tap dialog that excuses Trigly from
      battery optimisation, instead of only the settings list. Google Play
      restricts this intent to an app whose core function needs to keep
      running in the background while the screen is off, which Trigly's
      engine does: without the exemption Android can stop it while the phone
      is idle, and every rule stops with it. This is a declared, deliberate
      use for that reason. See MainActivity.requestIgnoreBatteryOptimizations.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      allowBackup stays true, and the rule database's exposure sits behind a
      user-controlled switch instead of behind a static "no": TriglyBackupAgent
      obeys it, and SettingsScreen is where a person sees it and can turn it
      off. allowBackup itself is read once when the APK is built and cannot
      become a runtime setting on its own, which is the whole reason
      backupAgent exists here.

      fullBackupOnly keeps the system calling TriglyBackupAgent's full-backup
      method rather than switching to the older key/value contract just
      because a custom agent is now declared. See that class's own KDoc.
      There is deliberately no fullBackupContent or dataExtractionRules
      resource: the agent's runtime check replaces what those static files
      would otherwise have to say.
    -->
    <application
        android:name=".TriglyApp"
        android:allowBackup="true"
        android:backupAgent=".TriglyBackupAgent"
        android:fullBackupOnly="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Trigly">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Trigly"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Where a tap on a pinned shortcut lands. exported="true" is required
          for the same reason as BootReceiver below: the launcher is a
          different app and can only start this by explicit component name if
          it is exported, regardless of intent-filter matching.

          Theme.NoDisplay rather than a translucent theme: this activity never
          draws, and NoDisplay is the platform's own contract for that - it
          requires finish() to be called before onResume completes and throws
          if it is not, which makes "draws nothing" a checked property instead
          of a hope. excludeFromRecents and noHistory keep a tap from leaving
          behind a task entry or a back-stack entry for an activity nobody
          will ever see.

          taskAffinity is empty, and that one attribute is the difference
          between a shortcut that fires a rule and a shortcut that opens the
          app. Without it this activity belongs to Trigly's own task, so a
          launcher starting it finds that task, brings the whole thing forward,
          and puts this activity on top. This activity records the tap and
          finishes a millisecond later, and what it uncovers is MainActivity.
          The shortcut therefore appears to open the app, but only when the app
          has been used recently enough to still own a task, which is why it
          reads as intermittent rather than as broken. An empty affinity gives
          it a task of its own that shares nothing, so there is never a task to
          bring forward.

          Fixed here rather than with FLAG_ACTIVITY_NEW_TASK on the pinned
          intent, for a reason that outweighs either: a shortcut carries the
          intent it was pinned with, so an intent change would fix only
          shortcuts pinned afterwards and leave every one already on a home
          screen broken. The manifest is read at launch, so this repairs those
          too.
        -->
        <activity
            android:name=".ShortcutTargetActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
          Two types, and each is there for its own reason.

          `location` is not a description of the service, it is the switch
          that lets the engine read a position while the app is in the
          background. Without it the fine-location grant is "while in use"
          only, and every `location_check` in an AND answered "I cannot look".
          The type is only claimed at runtime when a location permission is
          held; see `EngineService.foregroundTypes`.

          specialUse, and there is no honest alternative. The catalogue of
          foreground service types describes what the service is *doing*:
          playing media, syncing data, tracking a location. General-purpose
          automation is none of them. dataSync is the tempting mislabel and is
          also the one Android 15 caps at six hours a day, which would stop the
          engine every evening. specialUse carries no timeout; the price is that
          Google reviews the subtype string below before a Play release, which
          is a fair price for saying what the service actually is.

          The subtype string names the events that do *not* need this service,
          and it has to. It used to say that Trigly's triggers reach only a live
          process, full stop. That was true when it was written and it is not
          true now: a Bluetooth connect reaches a manifest receiver and starts
          the app, which is the whole reason that trigger works from an idle
          phone. A justification that overstates its case is worth less than one
          that states the exception, both to a reviewer and to the next person
          who reads it here. The same is now true of a repeating or a
          sunrise/sunset rule's own alarm, through AlarmWakeReceiver; see that
          class and docs/todo.md's T17.
        -->
        <service
            android:name=".EngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the user's own automation rules. Most of Trigly's triggers are system broadcasts and framework callbacks that Android delivers only to a running process, such as a screen, power, radio or call state change. A rule on one of those cannot fire unless this service keeps the process alive. The few events that can start the app by themselves already do, through a manifest receiver or a service the system binds: a device restart, an app update, a shortcut tap, a Bluetooth device connecting or disconnecting, a notification, an accessibility event, and a repeating or sunrise/sunset rule's own alarm. This service exists for the rest." />
        </service>

        <!--
          exported="true" is required, not incidental: both actions are sent by
          the system, which is a different uid, and a non-exported receiver only
          hears from its own app. Both are protected broadcasts that only the
          system may send, so nothing else can reach this.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          exported="true" for the same reason as BootReceiver above: the system
          sends both actions from a different uid, and a non-exported receiver
          only hears from its own app. Both are protected broadcasts, so
          nothing else can reach this. See BluetoothConnectionReceiver's own
          doc for why these two actions and no others, and for why starting
          the engine from here is permitted rather than merely convenient.
        -->
        <receiver
            android:name=".BluetoothConnectionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!--
          Not exported, unlike BootReceiver and BluetoothConnectionReceiver
          above: the sender here is this app's own PendingIntent, built by
          AlarmManagerScheduler in :triggers and scoped to this app's own
          package, not the system. The action string below has to match
          AlarmWakeEvents.ACTION_ALARM_WAKE exactly, the same duplication a
          platform action already forces on the two receivers above; see
          AlarmWakeReceiver's own doc for why this class cannot simply name
          that constant instead.
        -->
        <receiver
            android:name=".AlarmWakeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.phueber.trigly.action.ALARM_WAKE" />
            </intent-filter>
        </receiver>

        <!--
          Hands one rule's JSON to whichever app the person picks from the share
          sheet. Needed because a content URI is the only way to pass a file to
          another app without either of them holding a storage permission: the
          grant is per URI, read only, and lasts as long as the receiving
          activity.

          `exported="false"` with `grantUriPermissions="true"` is the pair that
          makes that true. Not exported means no app may query this provider on
          its own; the grant means the one app we handed a URI to may read that
          one file. An exported provider would be readable by anything installed.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

    </application>

</manifest>
