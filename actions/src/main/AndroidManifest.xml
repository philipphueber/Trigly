<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Runtime permission from API 33; without it posted notifications are dropped silently. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Install-time, granted automatically; declared so the vibrate action works. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Install-time. Needed by the HTTP action, which is how rules reach
         webhooks and home automation. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The overlay permission, and it is here for its side effect rather than for
      drawing anything. Holding it is one of the few exemptions from the ban on
      an app in the background starting an activity, which is what every "open"
      action needs — see docs/actions.md.

      Declared but not granted: this is an appop the user turns on in a settings
      screen, so the actions that need it declare it as a ComponentRequirement
      and the editor explains it. Nothing here asks for it at install time.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      The flashlight, and there is no permission line to go with it.
      CameraManager.setTorchMode needs none: the SDK's own permission database
      (platforms/android-35/data/annotations.zip) marks both openCamera
      overloads with RequiresPermission(CAMERA) and marks nothing on
      setTorchMode, turnOnTorchWithStrengthLevel or registerTorchCallback. So
      the flashlight actions run with no prompt.

      required="false" is what keeps the app installable on a phone with no
      flash unit. The two actions declare the feature as a ComponentRequirement
      instead, so a phone without one is never offered them. The camera group is
      declared beside it, also optional, because asking for the flash implies
      the camera and an implied feature is required by default.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

</manifest>
