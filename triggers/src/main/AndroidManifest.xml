<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Declared by the module that needs them rather than centrally in :ui, so a
      contributor adding a trigger declares its permissions next to its code.
      The manifest merger folds these into the app manifest.

      BLUETOOTH_CONNECT is a runtime permission from API 31; reading
      BluetoothDevice.address without it throws, and ACTION_STATE_CHANGED is not
      delivered. The legacy BLUETOOTH permission covers API 30 and below.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!-- Call state. The caller's number would additionally need READ_CALL_LOG,
         which Play restricts to default dialers; the call trigger deliberately
         does without it. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Location trigger. From API 31 the user can grant approximate location
         instead of precise, so the platform requires both to be declared; the
         GPS provider the trigger uses still needs the fine grant, which is what
         the trigger declares as its requirement. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Background location, which this app must have and put off asking for
      until now.

      The fine grant alone is "while in use". It gives a position only while
      an activity is on screen, or while a foreground service of type
      `location` runs. The engine is neither of those things most of the time.
      So the `location_check` component answered "I cannot look" for every
      rule that ran with the app in the background, the AND above it did not
      hold, and the rule was dropped with no record. That reads exactly like
      "you are not in the area", which is the silent failure this project
      designs against.

      The grant arrived in Android 10 (API 29). Below that the fine grant is
      already background access, and this line is ignored. The user must set
      location to "Allow all the time", and from Android 11 only the settings
      screen can do that. See `LocationCheckTriggerFactory` for the
      requirement, and `MainActivity.resolve` for where the user is sent.

      This is a Play review item, as is the `location` service type in :ui.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Usage-stats access is a special access granted in settings, but the
         permission must still be declared for the app-op to be checkable. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      SMS. Play restricts these to the user's default SMS app and the
      restriction survives user consent, so a Play build cannot ship the SMS
      trigger. The trigger declares ComponentRequirement.PolicyRestricted so the
      UI can hide it; see docs/triggers.md.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!--
      required="false" so the app still installs on devices without the hardware.
      Triggers declare matching SystemFeature requirements, which is how the UI
      knows to hide them on those devices rather than offer something that can
      never fire.
    -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application>

        <!--
          Both services are inert until the user enables them in system settings.
          Declaring them costs nothing at runtime; neither is bound otherwise.
        -->
        <service
            android:name=".notification.TriglyNotificationListenerService"
            android:exported="false"
            android:label="Trigly"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".accessibility.TriglyAccessibilityService"
            android:exported="false"
            android:label="Trigly"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
