# Personal Claude Code overrides (machine/user specific, not project config)
.claude/settings.local.json
.claude/worktrees/

# Gradle / Android build output
.gradle/
build/
local.properties
*.apk
*.aab
captures/

# Built release artifacts, collected here by `:ui:distRelease` for a human to
# pick up. Output of a build, so not tracked — the published copy lives on the
# release, not in the repository.
dist/

# Release signing. The keystore and its passwords are per-maintainer and
# must never be committed; docs/releasing.md says how to recreate them.
keystore.properties
*.jks
*.keystore

# IDE
.idea/
*.iml
.kotlin/

# OS
.DS_Store

# Internal review notes. A sweep report is a snapshot of one moment in the
# working tree, so it goes stale as soon as the code moves. Keep it on disk,
# out of the repository.
UX-Findings.md
